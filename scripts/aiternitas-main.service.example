[Unit]
Description=Aiternitas Main (aiternitas.ru)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aiternitas-main
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5

# Переменные окружения: скопируйте env.production.example в /opt/aiternitas-main/.env.production
# и заполните SESSION_SECRET и др. Затем раскомментируйте строку ниже.
# EnvironmentFile=/opt/aiternitas-main/.env.production

# Или задайте переменные прямо здесь (SESSION_SECRET сгенерируйте: node scripts/generate-session-secret.mjs):
# Environment=NODE_ENV=production
# Environment=PORT=3001
# Environment=HOST=0.0.0.0
# Environment=FRONTEND_URL=https://aiternitas.ru
# Environment=BASE_URL=https://aiternitas.ru
# Environment=DB_HOST=127.0.0.1
# Environment=DB_NAME=aiternitas
# Environment=DB_USER=postgres
# Environment=DB_PASSWORD=your_db_password
# Environment=SESSION_SECRET=your_random_64_char_hex

[Install]
WantedBy=multi-user.target
