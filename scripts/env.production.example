# Пример переменных окружения для production (aiternitas.ru)
# Скопируйте этот файл на сервер в /opt/aiternitas-main/.env.production
# и заполните значения. SESSION_SECRET сгенерируйте: node scripts/generate-session-secret.mjs

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Публичные URL
FRONTEND_URL=https://aiternitas.ru
BASE_URL=https://aiternitas.ru

# PostgreSQL (подставьте свои значения)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aiternitas
DB_USER=postgres
DB_PASSWORD=

# Секрет для сессий (обязательно сгенерируйте свой!)
# Запустите на сервере: node /opt/aiternitas-main/scripts/generate-session-secret.mjs
SESSION_SECRET=

# Опционально: почта
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@aiternitas.ru

# Опционально: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://aiternitas.ru/api/auth/google/callback
